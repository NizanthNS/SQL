/* ============================================================
   44. COHORT + FILTERED ACTIVITY
   ============================================================ */

WITH CTE AS (
    SELECT Customer_ID,
           DATE_FORMAT(
               Join_Date,
               '%Y-%m'
           ) AS Cohort_Month
    FROM Customers
),

CTE2 AS (
    SELECT *
    FROM Orders
    WHERE Order_Status = 'Completed'
)

SELECT
    C.Cohort_Month,

    COUNT(DISTINCT C.Customer_ID)
        AS Total_Customers,

    COUNT(O.Order_ID)
        AS Total_Completed_Orders,

    SUM(O.Order_Amount)
        AS Total_Completed_Revenue,

    ROUND(AVG(O.Order_Amount), 2)
        AS Average_Completed_Amount

FROM CTE C

LEFT JOIN CTE2 O
    ON C.Customer_ID = O.Customer_ID

GROUP BY C.Cohort_Month;


