/* ============================================================
   43. COHORT ANALYSIS
   ============================================================ */

-- Step 1:
-- Find when customer joined

WITH CTE AS (
    SELECT Customer_ID,
           DATE_FORMAT(
               Join_Date,
               '%Y-%m'
           ) AS Cohort_Month
    FROM Customers
)

SELECT *
