/* ============================================================
   68. ⭐⭐⭐ MASTER PATTERN
   ============================================================

   Most advanced SQL questions can be broken into:

       FILTER
          ↓
       JOIN
          ↓
       AGGREGATE
          ↓
       WINDOW FUNCTION
          ↓
       FILTER RESULT


   Example:

   WITH CTE AS (...)

   SELECT *
   FROM (
       SELECT ...,
              DENSE_RANK() OVER(...) AS RN
       FROM (
           SELECT ...
           FROM Table1
           JOIN Table2
           WHERE ...
           GROUP BY ...
       ) A
   ) B
   WHERE RN <= 3;


