/* ============================================================
   1. BASIC SELECT
   ============================================================ */

-- Select everything
SELECT *
FROM table_name;

-- Select specific columns
SELECT column1, column2
FROM table_name;

-- Rename columns using ALIAS
SELECT column1 AS New_Name
FROM table_name;

-- DISTINCT values
SELECT DISTINCT column1
FROM table_name;

-- Filter rows
SELECT *
FROM table_name
WHERE column1 = 'Value';

-- Multiple conditions
SELECT *
FROM table_name
WHERE column1 = 'Value'
  AND column2 > 100;

-- OR
SELECT *
FROM table_name
WHERE column1 = 'Value'
   OR column2 > 100;

-- NOT
SELECT *
FROM table_name
WHERE column1 <> 'Value';


