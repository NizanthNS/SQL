      ↓
   Aggregate

   ============================================================ */


/* ============================================================
   45. GAP & ISLAND
   ⭐ VERY IMPORTANT
   ============================================================ */

-- Problem:
--
-- Find consecutive dates / streaks.


/* STEP 1
   Remove duplicate dates
*/

WITH CTE AS (
    SELECT DISTINCT
           Customer_ID,
           Activity_Date
    FROM Activity
)


/* STEP 2
   Number each date
*/

, CTE2 AS (
    SELECT *,
           ROW_NUMBER() OVER(
               PARTITION BY Customer_ID
               ORDER BY Activity_Date
           ) AS RN
    FROM CTE
)


/* STEP 3
   Create Group Key
*/

, CTE3 AS (
    SELECT *,
           DATE_SUB(
               Activity_Date,
               INTERVAL RN DAY
           ) AS GK
    FROM CTE2
)


/* STEP 4
   Find each streak
*/

, CTE4 AS (
    SELECT
        Customer_ID,
        COUNT(*) AS Streak,
        MIN(Activity_Date) AS Start_Date,
        MAX(Activity_Date) AS End_Date

    FROM CTE3

    GROUP BY Customer_ID, GK
)


/* STEP 5
   Find longest streak
*/

, CTE5 AS (
    SELECT *,
           ROW_NUMBER() OVER(
               PARTITION BY Customer_ID
               ORDER BY Streak DESC,
                        End_Date DESC
           ) AS Row_Num

    FROM CTE4
)


SELECT
    Customer_ID,
    Streak AS Longest_Streak,
    Start_Date,
    End_Date

FROM CTE5

WHERE Row_Num = 1;


/* ============================================================
   🧠 GAP & ISLAND MEMORY
   ============================================================

   DISTINCT
       ↓
   ROW_NUMBER()
       ↓
   DATE_SUB(Date, RN)
       ↓
   GROUP BY Group_Key
       ↓
   COUNT = Streak
       ↓
   ROW_NUMBER()
       ↓
   Longest streak

   ⭐ Key idea:

   Consecutive dates produce
   the SAME Group Key.

   ============================================================ */


